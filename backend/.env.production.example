APP_NAME="IntentGuard API"
APP_ENV=production
APP_KEY=base64:GENERATE_PRODUCTION_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.intentguard.internal

LOG_CHANNEL=stack
LOG_LEVEL=info

# Production Database (MySQL 8.0+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=intentguard_production
DB_USERNAME=intentguard_app
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# High-Performance Caching & Queues
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
CACHE_STORE=redis

# Redis Cache Cluster
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum Stateful Domains & CORS
SANCTUM_STATEFUL_DOMAINS=portal.intentguard.internal,intentguard.internal
SESSION_DOMAIN=.intentguard.internal

# Payment Gateway - PayPal Live Configuration
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=PRODUCTION_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=PRODUCTION_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=PRODUCTION_WEBHOOK_ID

# Semantic Purchase Integrity Engine SLAs
SPIE_MAX_LATENCY_MS=250
SPIE_MIN_CONFIDENCE_THRESHOLD=0.8500
TDE_AUTO_HOLD_SCORE_THRESHOLD=70.00
